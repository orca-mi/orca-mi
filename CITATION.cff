version: 0.1.0
date-released: 2026-11-16
repository-code: "https://github.com/orca-mi/orca-mi"
url: "https://github.com/orca-mi/orca-mi"
license-url: "https://github.com/orca-mi/orca-mi/blob/main/LICENSE"
keywords:
  - molecular imaging
  - nuclear medicine
  - medical imaging
  - DICOM
  - PET
  - SPECT
  - segmentation
  - dosimetry
  - nnU-Net
  - nnInteractive
